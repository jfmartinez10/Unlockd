{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/pages/index.html"
    },
    {
      "source": "/login",
      "destination": "/src/pages/auth/login.html"
    },
    {
      "source": "/registro",
      "destination": "/src/pages/auth/registro.html"
    },
    {
      "source": "/contacto",
      "destination": "/src/pages/contacto/contacto.html"
    },
    {
      "source": "/producto",
      "destination": "/src/pages/producto/producto.html"
    }
  ],
  "headers": [
    {
      "source": "/public/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}