# ─── Servidor ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos (Supabase → Connect → Direct) ──────────
# Copia la cadena del tab "Direct" en el modal Connect de Supabase
# Formato: postgresql://postgres.[REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.swjcadgncozhyxvlaavi:[TU_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ─── JWT ──────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_64_BYTES_ALEATORIOS
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_64_BYTES_ALEATORIOS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Email (Gmail o Brevo) ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu@gmail.com
MAIL_PASS=app_password_de_16_caracteres
MAIL_FROM="Unlockd <tu@gmail.com>"

# ─── Frontend (para CORS y emails) ────────────────────────
CLIENT_URL=http://localhost:5500
